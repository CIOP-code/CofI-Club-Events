{
  "name": "club-events",
  "version": "1.0.0",
  "description": "Club Events app for College of Idaho – built on Cloudflare Pages + Workers + D1 + R2",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB",
    "deploy": "wrangler pages deploy public",
    "db:init": "wrangler d1 execute club-events-db --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
